{
    "name": "johndyates/inkwell",
    "description": "A small, hand-built content platform (CMS/blog) in vanilla PHP: MVC, PDO/MySQL, sessions, server-rendered templates.",
    "type": "project",
    "license": "MIT",
    "keywords": ["php", "mvc", "cms", "blog", "pdo", "mysql", "vanilla-php"],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8080 -t public"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
